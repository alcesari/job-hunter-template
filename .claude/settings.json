{
  "permissions": {
    "allow": [
      "Bash(curl -s http://localhost:3000/)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(bash scripts/publish_run.sh *)",
      "Bash(scripts/publish_run.sh *)",
      "Bash(python3 scripts/merge_operational.py *)",
      "Bash(python scripts/merge_operational.py *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git rm digests/*)",
      "Bash(git rm source-log/*)",
      "Bash(git rm -r staging/*)",
      "Bash(git rm -r --cached staging/*)",
      "Bash(python scripts/send_digest.py *)",
      "Bash(python3 scripts/send_digest.py *)",
      "Bash(python scripts/fetch_careers.py *)",
      "Bash(python3 scripts/fetch_careers.py *)",
      "Bash(python scripts/verify_cv_facts.py *)",
      "Bash(python3 scripts/verify_cv_facts.py *)",
      "Bash(python scripts/check_liveness.py *)",
      "Bash(python3 scripts/check_liveness.py *)",
      "Edit(state.json)",
      "Edit(PIPELINE.md)",
      "Edit(source-log/**)",
      "Edit(staging/**)",
      "Edit(digests/**)",
      "Write(state.json)",
      "Write(PIPELINE.md)",
      "Write(source-log/**)",
      "Write(staging/**)",
      "Write(digests/**)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": []
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
